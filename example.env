# Copy to .env.local and fill in real values. See:
# /Users/mohsenmirzaei/.claude/plans/tingly-forging-hippo.md

# Postgres connection string (Vercel Postgres → Storage tab on the
# mohsenmirzaei-hg6j project auto-injects this in Vercel's env vars).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend API key (https://resend.com/api-keys). Contact form still works and
# saves leads without this — it just skips the notification email.
RESEND_API_KEY=""

# Must be on a domain verified in Resend. Defaults to Resend's shared test
# sender if unset (fine for local dev, not for production).
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
